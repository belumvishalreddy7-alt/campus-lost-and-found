# ------------------------------------------------------------------
# Campus Lost and Found Portal - environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/campus_lost_found
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus_lost_found?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Client origin allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5000

# Data store driver: "mongo" (default) or "memory" (offline demo / tests only)
DB_DRIVER=mongo

# Seed demo accounts + 12 sample items on first start (true/false)
SEED_ON_START=true
